{
  "name": "obsidian-theme-helm-console",
  "version": "0.5.0",
  "private": true,
  "description": "Helm Console: an Obsidian theme of swept colour bars, rounded end caps and segmented panels, inspired by late-1980s television science-fiction console graphics.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "oxlint",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "oxlint && node scripts/build.mjs --check && node --test \"tests/*.test.mjs\"",
    "deploy": "node scripts/build.mjs && node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "oxlint": "1.78.0"
  }
}
